# Книга семьи — переменные окружения.
# Значения кладём ТОЛЬКО в Vercel Env (Production + Preview) и GitHub Secrets.
# Локально: скопируй в .env.local. Без ключей всё работает в AI_MODE=mock.

# --- Supabase (Project Settings → API / Connect) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Секретный ключ: только сервер, никогда в браузер и не с префиксом NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler (IPv4). Нужен только GitHub Actions (workflow migrate)
SUPABASE_DB_URL=

# --- ИИ ---
# Google AI Studio, без биллинга (бесплатная квота)
GEMINI_API_KEY=
# OpenAI с лимитом расходов — платный резерв
OPENAI_API_KEY=
# mock | auto | gemini | openai. Пусто = mock, если нет ни одного ключа, иначе auto
AI_MODE=mock

# Режим сцены (I12): 1 — на питче. Шаг ИИ для демо-семьи не ответил за 20 с → показываем заранее
# готовый результат этой демо-истории (в логах «[stage]»). Настоящих семей не касается. Пусто / 0 — выключен.
STAGE_MODE=

# --- Доступ ---
# PIN админки /admin и /admin/ai
ADMIN_PIN=
# PIN волонтёра киоска АКНЦ /kiosk
KIOSK_PIN=

# Подпись QR-ссылок на голос /listen (необязательно; пусто = выводится из service-ключа).
# Если задать — не меняйте после печати книг: старые QR перестанут открываться.
LISTEN_SECRET=

# --- Уведомления (необязательно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Прод ---
# Например https://kniga-semyi.vercel.app (для smoke-проверки)
PROD_URL=
